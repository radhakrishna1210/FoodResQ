# "development" locally, "production" when deployed. In production, the app refuses to start if
# DEV_AUTH_ENABLED is true or any secret below is still a placeholder (see main.py).
ENVIRONMENT=development

# Supabase Postgres connection string (or local docker-compose Postgres for development)
DATABASE_URL=postgresql+psycopg://foodresq:foodresq@localhost:5432/foodresq
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                     # server only, never sent to the browser
SUPABASE_JWT_SECRET=                           # or use SUPABASE_JWKS_URL, depending on project settings
SUPABASE_JWKS_URL=
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
INTERNAL_TICK_SECRET=change-me
GEMINI_API_KEY=                                # Phase 6 only; get one from Google AI Studio (aistudio.google.com)
GEMINI_MODEL=                                  # set to a current Gemini model id; never hard-code

# Google Sign-In (direct OAuth 2.0 authorization-code flow, no Supabase). From Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
APP_JWT_SECRET=                                # random secret signing real Google-verified sessions
FRONTEND_BASE_URL=http://localhost:5173

# Matching engine (Stage-2 scorer). "bridge" = our own formula (default; what the test suite assumes).
# "jev" = TypeSafe AI's Jev API — early access, untested against a real key (see
# services/matching/jev_adapter.py). Falls back to "bridge" per-candidate on any Jev error.
MATCHING_ENGINE=bridge
TYPESAFE_JEV_API_KEY=

EMAIL_NOTIFICATIONS_ENABLED=false

# TODO(team): prototype-only convenience. When true, POST /api/v1/dev/login mints a token for a
# seeded user without Supabase Auth. Signed with DEV_JWT_SECRET. Must be false in any deployment.
DEV_AUTH_ENABLED=false
DEV_JWT_SECRET=local-dev-secret-change-me
