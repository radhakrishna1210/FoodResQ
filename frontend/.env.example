# Backend API base (FastAPI). /health is derived by stripping /api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Supabase (auth, signed-URL uploads, realtime). Leave empty to use dev auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Prototype convenience: shows "Demo accounts" on /login and uses POST /dev/login.
# TODO(team): remove dev auth before the pilot.
VITE_DEV_AUTH=true
